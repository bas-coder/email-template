  {
    "name": "support-nudge",
    "html": "emails/support-nudge.html",
    "text": "emails/support-nudge.txt",
    "audience": "AIWA team",
    "subject": "Support nudge: {{user_name}}'s deploy keeps failing",
    "preheader": "{{user_name}} ({{user_email}}) needs help. Their deploy has failed repeatedly.",
    "variables": [
      "error_log",
      "tickets_url",
      "user_email",
      "user_name"
    ],
    "sample": {
      "user_name": "stuckuser",
      "user_email": "stuckuser@example.com",
      "error_log": "npm error code EUSAGE\nnpm error `npm ci` can only install packages when your package.json and package-lock.json are in sync.\nnpm error Invalid: lock file's @radix-ui/react-slot@1.3.0 does not satisfy @radix-ui/react-slot@1.3.3",
      "tickets_url": "https://localhost:4000/admin/tickets"
    }
  },
