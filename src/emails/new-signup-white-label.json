{
  "preview": {
    "label": "white-label signup",
    "order": 10
  },
  "subject": "New signup on {{platform_name}}: {{user_name}}",
  "preheader": "{{user_name}} signed up on {{platform_name}}. They are platform user #{{user_number}}.",
  "audience": "AIWA team",
  "tab": "New signup &middot; White label",
  "header": "title",
  "title": "{{user_name}}",
  "footerMark": true,
  "blocks": [
    {
      "type": "meta",
      "html": "<a class=\"t-link lnk\" href=\"mailto:{{user_email}}\" style=\"color:#BF4E0B; text-decoration:underline;\">{{user_email}}</a>"
    },
    {
      "type": "p",
      "html": "Signed up on <strong style=\"font-weight:600;\">{{platform_name}}</strong>, <a class=\"t-link lnk\" href=\"{{platform_url}}\" style=\"color:#BF4E0B; text-decoration:underline;\">{{platform_url}}</a>."
    },
    {
      "type": "p",
      "html": "They are platform user <strong style=\"font-weight:600;\">#{{user_number}}</strong>."
    },
    {
      "type": "button",
      "label": "Open the control panel",
      "url": "{{control_panel_url}}",
      "arrow": true
    }
  ],
  "sample": {
    "user_name": "Jamie Rivers",
    "user_email": "newuser@example.com",
    "platform_name": "BJCrum",
    "platform_url": "https://app.bjcrum.com",
    "user_number": "128",
    "control_panel_url": "http://localhost:4000/admin"
  }
}
